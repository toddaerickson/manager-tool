# Environment variable inventory for the Django app (Phase 1+).
# This file is the source of truth for which vars must exist in any env
# (.env locally, Render dashboard in prod, CI secrets, etc.).
# All values here are empty by design. NEVER commit real secrets.

# --- Database -----------------------------------------------------------
# Neon Postgres connection. Use the dev branch (dev-django) during Phases
# 1-6. Switch to the production branch only at Phase 7 cutover.
# Pattern (replace <PASSWORD> and verify host suffix):
#   postgresql://neondb_owner:<PASSWORD>@ep-purple-boat-ajv694zw-pooler.c-3.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# --- Django -------------------------------------------------------------
# 50+ char random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames the app is allowed to serve. Local dev:
# "localhost,127.0.0.1". Add the Render hostname before Phase 4 deploy.
DJANGO_ALLOWED_HOSTS=

# Set to "prod" in production (gates encryption-key auto-generation off
# and forces SQLite fallback off when DATABASE_URL is set).
MANAGER_TOOL_ENV=

# --- Encryption (sensitive config) --------------------------------------
# Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Same key must be used everywhere the app runs against the same DB,
# otherwise existing encrypted config rows can't be decrypted.
CONFIG_ENCRYPTION_KEY=

# --- Observability ------------------------------------------------------
# Sentry DSN from sentry.io project settings. Wired in Phase 1.
SENTRY_DSN=

# --- Account email / password reset (Resend) -----------------------------
# Self-serve password-reset links are sent through Resend's HTTP API, not
# through any manager's SMTP account. Create a key at
# https://resend.com/api-keys (it starts with "re_"), verify the sending
# domain at https://resend.com/domains (SPF + DKIM), then set both vars.
# Without EMAIL_API_KEY the app still boots; reset mail is dropped and
# logged at ERROR (see core/email_backend.py).
EMAIL_API_KEY=
# Must be an address on the verified domain. An unverified domain makes
# every send fail with HTTP 403. Replies are routed to the manager instead.
DEFAULT_FROM_EMAIL=
# Optional: comma-separated addresses that `manage.py send_test_email` may
# mail even though they have no Manager row. Empty = known managers only.
EMAIL_API_ALLOWED_RECIPIENTS=

# --- Google OAuth (Phase 3) ---------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials.
# Add redirect URIs there:
#   http://localhost:8000/accounts/google/login/callback/
#   https://<render-hostname>/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
