{
  "name": "Manager Tool (Django)",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "manager-tool-django/README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // The Streamlit app (web_app.py) was retired 2026-07-16; this container
  // now targets the Django app in manager-tool-django/.
  "postCreateCommand": "cd manager-tool-django && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "cd manager-tool-django && .venv/bin/python manage.py runserver 0.0.0.0:8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Django App",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}