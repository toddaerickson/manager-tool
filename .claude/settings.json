{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(render services*)",
      "Bash(render deploys list *)",
      "Bash(render logs *)",
      "Bash(render blueprints validate *)",
      "Bash(render whoami)",
      "Bash(render workspaces*)",
      "Bash(gh secret list *)"
    ]
  }
}
